{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuizPort Quiz Schema",
  "description": "JSON Schema for QuizPort quiz format",
  "type": "object",
  "required": ["title", "questions"],
  "properties": {
    "title": {
      "type": "string",
      "description": "The title of the quiz",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "description": "A brief description of the quiz",
      "maxLength": 500
    },
    "difficulty": {
      "type": "string",
      "description": "The difficulty level of the quiz",
      "enum": ["Easy", "Medium", "Hard"]
    },
    "category": {
      "type": "string",
      "description": "The category of the quiz",
      "enum": ["science", "history", "programming", "math", "languages", "general"]
    },
    "tags": {
      "type": "array",
      "description": "Tags for better discoverability",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "questions": {
      "type": "array",
      "description": "Array of quiz questions",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "properties": {
          "question": {
            "type": "string",
            "description": "The question text",
            "minLength": 1
          },
          "choices": {
            "type": "array",
            "description": "Array of answer choices (optional for text answer questions)",
            "items": {
              "type": "string"
            },
            "minItems": 2
          },
          "answer": {
            "description": "The correct answer: a 0-based index into `choices` for single choice, an array of indices for multi-select, or the literal text for an open response.",
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "description": "Multi-select: every index that must be chosen.",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 1,
                "uniqueItems": true
              }
            ]
          },
          "type": {
            "type": "string",
            "description": "Optional. The question kind is normally inferred from the shape of `answer` and `choices`, so this is only needed to disambiguate. Omit it unless you must.",
            "enum": ["single", "multi", "boolean", "text"]
          },
          "acceptable": {
            "type": "array",
            "description": "Open-response questions only. Additional spellings accepted alongside `answer`. Matching already ignores case, surrounding whitespace and trailing punctuation.",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "explanation": {
            "type": "string",
            "description": "Explanation of the correct answer, shown after the user answers. Every quiz in this library provides one for every question."
          },
          "hint": {
            "type": "string",
            "description": "Optional hint, available before the user answers."
          }
        }
      }
    },
    "author": {
      "type": "string",
      "description": "The author of the quiz"
    },
    "version": {
      "type": "string",
      "description": "Version of the quiz",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "created": {
      "type": "string",
      "description": "Creation date in ISO 8601 format",
      "format": "date-time"
    },
    "updated": {
      "type": "string",
      "description": "Last update date in ISO 8601 format",
      "format": "date-time"
    }
  }
}
